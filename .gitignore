.DS_Store
Thumbs.db
desktop.ini

# Carpetas de configuración de editores
.vscode/
*.code-workspace

# Dependencias (si en el futuro se agrega Node.js, Sass, etc.)
node_modules/

# Archivos temporales
*.log
*.tmp
